# Configuración de base de datos
DATABASE_URL=postgres://ergonomia:ergonomia_dev@localhost:5433/ergonomia?sslmode=disable

# Configuración JWT (cambiar en producción)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Configuración del servidor
PORT=8080
ENV=development

# CORS (comas separadas)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Configuración de Email
# Provider: "console" (desarrollo), "resend" (producción), "smtp"
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=noreply@ergonomia.pro
EMAIL_FROM_NAME=Ergonomía Pro

# Para SMTP (si se usa en lugar de Resend)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
